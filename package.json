{
  "name": "frontier-decision-engine",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Browser-local, human-governed decision support for choices under deep uncertainty.",
  "scripts": {
    "test": "node --test",
    "facts": "node scripts/generate-project-facts.mjs",
    "facts:check": "node scripts/validate-project-facts.mjs",
    "validate": "python3 scripts/validate_repository.py",
    "manifest": "node scripts/build-manifest.mjs",
    "test:e2e": "python3 scripts/browser_e2e.py",
    "check": "npm run facts:check && npm test && npm run validate:version && npm run validate && npm run manifest && npm run test:e2e && npm run test:closeout",
    "package:release": "python3 scripts/package_release.py",
    "capture:screenshots": "python3 scripts/capture_screenshots.py",
    "validate:version": "python3 scripts/validate_version_integrity.py",
    "test:closeout": "python3 scripts/browser_closeout_regressions.py"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0"
}
